// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  lastLoginAt DateTime?
  loginResetRequired Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shops     Shop[]
  sessions  AuthSession[]
  shopMemberships ShopMember[]
  staffInvitesCreated StaffInvite[] @relation("StaffInviteCreator")
  passwordResetTokens StaffPasswordResetToken[] @relation("StaffPasswordResetTarget")
  passwordResetTokensCreated StaffPasswordResetToken[] @relation("StaffPasswordResetCreator")
  ownerPasswordResetChallenges OwnerPasswordResetChallenge[]
}

model AuthSession {
  id              String   @id @default(cuid())
  userId          String
  tokenHash       String   @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedById    String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy      AuthSession?  @relation("SessionRotation", fields: [replacedById], references: [id])
  replacedSession AuthSession?  @relation("SessionRotation")

  @@index([userId])
  @@index([expiresAt])
}

model Shop {
  id                  String                 @id @default(cuid())
  name                String
  address             String?
  logoUrl             String?
  logoPublicId        String?
  ownerId             String
  approvalPinHash     String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  owner               User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customers           Customer[]
  categories          Category[]
  products            Product[]
  inventory           InventoryBatch[]
  adjustments         StockAdjustment[]
  orders              Order[]
  payments            Payment[]
  saleExchanges       SaleExchange[]
  expenses            Expense[]
  auditLogs           AuditLog[]
  suppliers           Supplier[]
  supplierDeliveryRecords SupplierDeliveryRecord[]
  supplierDeliveryPayments SupplierDeliveryPayment[]
  supplierDeliveryPaymentReversals SupplierDeliveryPaymentReversal[]
  purchases           Purchase[]
  productSuppliers    ProductSupplier[]
  setting             ShopSetting?
  templateKey         String                 @default("GENERAL_STORE")
  capabilities        Json                   @default("{}")
  capabilityStates    Json                   @default("{}")
  onboardingCompleted Boolean                @default(false)
  ledgerEnabled       Boolean                @default(false)
  ledgerCutoverAt     DateTime?
  inventoryReadMode   String                 @default("LEGACY")
  units               UnitOfMeasure[]
  locations           InventoryLocation[]
  movements           InventoryMovement[]
  balances            InventoryBalance[]
  reservations        InventoryReservation[]
  lots                InventoryLot[]
  serials             InventorySerial[]
  warrantyRecords     WarrantyRecord[]
  customerPriceGroups CustomerPriceGroup[]
  customerReturns     CustomerReturn[]
  barcodes            ProductBarcode[]
  generatedBarcodes   GeneratedBarcode[]
  priceBooks          PriceBook[]
  priceEntries        PriceEntry[]
  promotions          Promotion[]
  promotionCampaigns  PromotionCampaign[]
  saleSequence        Int                    @default(0)
  notifications       Notification[]
  members             ShopMember[]
  rolePolicies        ShopRolePolicy[]
  staffInvites        StaffInvite[]
  passwordResetTokens StaffPasswordResetToken[]

  @@index([ownerId])
}

model ShopMember {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  role      String
  active    Boolean  @default(true)
  approvalPinHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId, active])
  @@index([userId, active])
}

model StaffInvite {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  email       String
  role        String
  tokenHash   String   @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById String
  lastSentAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("StaffInviteCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([shopId, email])
  @@index([shopId, expiresAt])
}

model StaffPasswordResetToken {
  id          String   @id @default(cuid())
  shopId      String
  userId      String
  createdById String
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user        User     @relation("StaffPasswordResetTarget", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("StaffPasswordResetCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([shopId, userId])
  @@index([userId, expiresAt])
}

model OwnerPasswordResetChallenge {
  id             String    @id @default(cuid())
  userId         String
  codeHash       String
  expiresAt      DateTime
  attemptCount   Int       @default(0)
  verifiedAt     DateTime?
  resetTokenHash String?   @unique
  resetExpiresAt DateTime?
  usedAt         DateTime?
  invalidatedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model ShopRolePolicy {
  id          String   @id @default(cuid())
  shopId      String
  role        String
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, role])
  @@index([shopId])
}

model ManagerApprovalToken {
  id          String    @id
  shopId      String
  requesterId String
  approverId  String
  action      String
  targetId    String
  payloadHash String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([shopId, expiresAt])
}

model ShopSetting {
  id                 String   @id @default(cuid())
  shopId             String   @unique
  productLabel       String   @default("Product")
  option1Label       String   @default("Option 1")
  option2Label       String   @default("Option 2")
  option2Enabled     Boolean  @default(true)
  productListLabel   String   @default("Products")
  option1ValuesLabel String   @default("Option 1 Values")
  option2ValuesLabel String   @default("Option 2 Values")
  option1Values      String   @default("[\"Standard\"]")
  option2Values      String   @default("[\"General\"]")
  paymentMethods     String   @default("[]")
  lowStockDefault    Int      @default(5)
  currencyCode       String   @default("MMK")
  dateFormat         String   @default("yyyy-MM-dd")
  locale             String   @default("en-MM")
  timeZone           String   @default("Asia/Yangon")
  receiptFooter      String   @default("Thank you for shopping with us.")
  notifyLowStock     Boolean  @default(true)
  notifyPayments     Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Customer {
  id           String              @id @default(cuid())
  name         String
  phone        String?
  email        String?
  address      String?
  city         String?
  notes        String?
  shopId       String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  shop         Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders       Order[]
  priceGroupId String?
  priceGroup   CustomerPriceGroup? @relation(fields: [priceGroupId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([priceGroupId])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  shopId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products  Product[]
  promotionCampaigns PromotionCampaign[]

  @@unique([shopId, name])
  @@index([shopId])
}

model Product {
  id                String                 @id @default(cuid())
  name              String
  description       String?
  sku               String?
  price             Int
  cost              Int?
  minimumStock      Int                    @default(0)
  optionTree        Json                   @default("{}")
  isActive          Boolean                @default(true)
  shopId            String
  categoryId        String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  shop              Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category          Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants          ProductVariant[]
  inventory         InventoryBatch[]
  orderItems        OrderItem[]
  purchaseItems     PurchaseItem[]
  capabilities      Json                   @default("{}")
  trackingMode      String                 @default("NONE")
  quantityPrecision Int                    @default(0)
  version           Int                    @default(1)
  units             ProductUnit[]
  balances          InventoryBalance[]
  movements         InventoryMovement[]
  stockAdjustments  StockAdjustment[]
  reservations      InventoryReservation[]
  lots              InventoryLot[]
  serials           InventorySerial[]
  recipe            Recipe?
  recipeComponents  RecipeComponent[]      @relation("RecipeIngredient")
  priceTiers        PriceTier[]
  customerReturns   CustomerReturn[]
  barcodes          ProductBarcode[]
  assignedBarcodes  GeneratedBarcode[]
  priceEntries      PriceEntry[]
  promotions        Promotion[]
  supplierLinks     ProductSupplier[]

  @@unique([shopId, sku])
  @@index([shopId])
  @@index([categoryId])
}

model ProductVariant {
  id               String                 @id @default(cuid())
  name             String
  sku              String?
  price            Int?
  cost             Int?
  option1          String?
  option2          String?
  option3          String?
  optionPath       Json                   @default("[]")
  variantSignature String?
  isActive         Boolean                @default(true)
  archivedAt       DateTime?
  isDefault        Boolean                @default(false)
  productId        String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  product          Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory        InventoryBatch[]
  orderItems       OrderItem[]
  purchaseItems    PurchaseItem[]
  balances         InventoryBalance[]
  movements        InventoryMovement[]
  reservations     InventoryReservation[]
  lots             InventoryLot[]
  serials          InventorySerial[]
  priceTiers       PriceTier[]
  barcodes         ProductBarcode[]
  priceEntries     PriceEntry[]
  promotions       Promotion[]

  @@unique([productId, sku])
  @@unique([productId, variantSignature])
  @@index([productId])
}

model InventoryBatch {
  id               String                @id @default(cuid())
  shopId           String
  productId        String
  variantId        String?
  quantity         Int
  baseQuantity     Decimal?              @db.Decimal(18, 3)
  reservedQuantity Int                   @default(0)
  unitCost         Int
  receivedAt       DateTime              @default(now())
  supplierName     String?
  invoiceReference String?
  note             String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  shop             Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product          Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  adjustments      StockAdjustment[]
  adjustmentAllocations StockAdjustmentAllocation[]
  allocations      OrderItemAllocation[]
  purchaseReceipts PurchaseReceipt[]
  purchaseReturns  PurchaseReturn[]
  movements        InventoryMovement[]
  lots             InventoryLot[]

  @@index([shopId])
  @@index([productId])
  @@index([variantId])
}

model Supplier {
  id            String     @id @default(cuid())
  shopId        String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  shop          Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  purchases     Purchase[]
  deliveryRecords SupplierDeliveryRecord[]
  productLinks  ProductSupplier[]

  @@index([shopId])
}

model ProductSupplier {
  id            String   @id @default(cuid())
  shopId        String
  productId     String
  supplierId    String
  lastUnitCost  Int?
  notes         String?
  lastOrderedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([shopId, productId, supplierId])
  @@index([shopId, productId])
  @@index([shopId, supplierId])
}

model Purchase {
  id                    String            @id @default(cuid())
  shopId                String
  supplierId            String
  purchaseNumber        String
  status                String            @default("draft")
  paymentStatus         String            @default("unpaid")
  orderedAt             DateTime          @default(now())
  expectedAt            DateTime?
  receivedAt            DateTime?
  deliveryCost          Int               @default(0)
  total                 Int               @default(0)
  paidAmount            Int               @default(0)
  notes                 String?
  supplierInvoiceNumber String?
  senderName            String?
  senderPhone           String?
  receiverName          String?
  cancelledAt           DateTime?
  cancelReason          String?
  cancelApprovedBy      String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  shop                  Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier              Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items                 PurchaseItem[]
  receipts              PurchaseReceipt[]
  payments              PurchasePayment[]
  returns               PurchaseReturn[]

  @@unique([shopId, purchaseNumber])
  @@index([shopId])
  @@index([shopId, status, updatedAt])
  @@index([supplierId])
  @@index([status])
}

model PurchaseItem {
  id                   String            @id @default(cuid())
  purchaseId           String
  productId            String
  variantId            String?
  productName          String
  quantity             Int
  receivedQuantity     Int               @default(0)
  receivedBaseQuantity Decimal           @default(0) @db.Decimal(18, 3)
  unitCost             Int
  plannedUnitCost      Int?
  plannedPromotionLabel String?
  lineTotal            Int
  unitId               String?
  enteredQuantity      Decimal?          @db.Decimal(18, 3)
  conversionFactor     Decimal?          @db.Decimal(18, 6)
  baseQuantity         Decimal?          @db.Decimal(18, 3)
  purchase             Purchase          @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product              Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant              ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  receipts             PurchaseReceipt[]
  returns              PurchaseReturn[]

  @@index([purchaseId])
  @@index([productId])
}

model PurchaseReceipt {
  id               String         @id @default(cuid())
  purchaseId       String
  purchaseItemId   String
  inventoryBatchId String
  quantity         Int
  baseQuantity     Decimal?       @db.Decimal(18, 3)
  idempotencyKey   String?
  note             String?
  receivedAt       DateTime       @default(now())
  purchase         Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseItem     PurchaseItem   @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)
  inventoryBatch   InventoryBatch @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)

  @@unique([purchaseId, purchaseItemId, idempotencyKey])
  @@index([purchaseId])
  @@index([purchaseItemId])
}

model PurchasePayment {
  id                String    @id @default(cuid())
  purchaseId        String
  amount            Int
  method            String
  reference         String?
  notes             String?
  payerName         String?
  payerPhone        String?
  signatureDataUrl  String?
  mobileAccountName String?
  paidAt            DateTime  @default(now())
  reversedAt        DateTime?
  reversalReason    String?
  createdAt         DateTime  @default(now())
  purchase          Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

model PurchaseReturn {
  id               String         @id @default(cuid())
  purchaseId       String
  purchaseItemId   String
  inventoryBatchId String
  quantity         Int
  baseQuantity     Decimal?       @db.Decimal(18, 3)
  amount           Int
  reason           String
  returnedAt       DateTime       @default(now())
  createdAt        DateTime       @default(now())
  purchase         Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseItem     PurchaseItem   @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  inventoryBatch   InventoryBatch @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([purchaseItemId])
}

model StockAdjustment {
  id               String         @id @default(cuid())
  shopId           String
  productId        String
  inventoryBatchId String?
  selectedUnitCost Int?
  action           String
  quantity         Int
  beforeQuantity   Int
  afterQuantity    Int
  reason           String
  staffName        String
  createdAt        DateTime       @default(now())
  shop             Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryBatch   InventoryBatch? @relation(fields: [inventoryBatchId], references: [id], onDelete: SetNull)
  allocations      StockAdjustmentAllocation[]

  @@index([shopId])
  @@index([inventoryBatchId])
  @@index([productId])
}

model StockAdjustmentAllocation {
  id                String          @id @default(cuid())
  stockAdjustmentId String
  inventoryBatchId  String
  quantity          Int
  createdAt         DateTime        @default(now())
  stockAdjustment   StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  inventoryBatch    InventoryBatch  @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)

  @@index([stockAdjustmentId])
  @@index([inventoryBatchId])
}

model Order {
  id                String           @id @default(cuid())
  shopId            String
  customerId        String?
  orderNumber       String?
  fulfillmentStatus String           @default("reserved")
  paymentStatus     String           @default("unpaid")
  subtotal          Int
  discount          Int              @default(0)
  deliveryFee       Int              @default(0)
  total             Int
  source            String?
  note              String?
  refundId          String?
  cancelledAt       DateTime?
  cancelReason      String?
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  paymentTracking   Boolean          @default(false)
  shop              Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer          Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  payments          Payment[]
  returns           CustomerReturn[]
  sourceExchanges   SaleExchange[]  @relation("OriginalSaleExchanges")
  replacementExchange SaleExchange? @relation("ReplacementSaleExchange")

  @@unique([shopId, orderNumber])
  @@index([shopId])
  @@index([customerId])
  @@index([fulfillmentStatus])
  @@index([paymentStatus])
  @@index([shopId, completedAt])
}

model OrderItem {
  id                 String                       @id @default(cuid())
  orderId            String
  productId          String
  variantId          String?
  productName        String
  variantName        String?
  quantity           Int
  unitPrice          Int
  unitCost           Int
  discount           Int                          @default(0)
  deductionType      String                       @default("discount")
  lineTotal          Int
  unitId             String?
  enteredQuantity    Decimal?                     @db.Decimal(18, 3)
  conversionFactor   Decimal?                     @db.Decimal(18, 6)
  baseQuantity       Decimal?                     @db.Decimal(18, 3)
  recognizedAt       DateTime?
  appliedTierId      String?
  pricingSnapshot    Json?
  regularUnitPrice   Int?
  tierUnitPrice      Int?
  promotionId        String?
  promotionType      String?
  promotionValue     Decimal?                     @db.Decimal(18, 4)
  promotionDiscount  Int                          @default(0)
  manualDiscount     Int                          @default(0)
  finalUnitPrice     Int?
  priceResolvedAt    DateTime?
  createdAt          DateTime                     @default(now())
  order              Order                        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant            ProductVariant?              @relation(fields: [variantId], references: [id], onDelete: SetNull)
  allocations        OrderItemAllocation[]
  returns            CustomerReturn[]
  serialAllocations  OrderItemSerialAllocation[]
  modifierSelections OrderItemModifierSelection[]
  appliedTier        PriceTier?                   @relation(fields: [appliedTierId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([appliedTierId])
}

model OrderItemAllocation {
  id               String         @id @default(cuid())
  orderItemId      String
  inventoryBatchId String
  quantity         Int
  baseQuantity     Decimal?       @db.Decimal(18, 3)
  unitCost         Int
  createdAt        DateTime       @default(now())
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  inventoryBatch   InventoryBatch @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([inventoryBatchId])
}

model Payment {
  id                String   @id @default(cuid())
  shopId            String
  orderId           String?
  exchangeId        String?
  type              String
  scope             String?
  method            String
  amount            Int
  billNumber        String?
  transactionId     String?
  orderIds          String?
  allocations       String?
  originalPaymentId String?
  reason            String?
  note              String?
  paidAt            DateTime @default(now())
  createdAt         DateTime @default(now())
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order             Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  exchange          SaleExchange? @relation(fields: [exchangeId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([orderId])
  @@index([exchangeId])
  @@index([billNumber])
  @@index([originalPaymentId])
  @@index([transactionId])
}

model Expense {
  id        String   @id @default(cuid())
  shopId    String
  title     String
  category  String?
  method    String?
  transactionId String?
  amount    Int
  spentAt   DateTime @default(now())
  note      String?
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([spentAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  shopId    String
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([actorId])
  @@index([entity])
  @@index([createdAt])
}

model OrderItemSerialAllocation {
  id          String          @id @default(cuid())
  orderItemId String
  serialId    String
  createdAt   DateTime        @default(now())
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  serial      InventorySerial @relation(fields: [serialId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, serialId])
  @@unique([serialId])
  @@index([orderItemId])
}

model SaleExchange {
  id                 String           @id @default(cuid())
  shopId             String
  originalOrderId    String
  replacementOrderId String           @unique
  actorId            String
  reason             String
  idempotencyKey     String
  requestHash        String
  createdAt          DateTime         @default(now())
  shop               Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  originalOrder      Order            @relation("OriginalSaleExchanges", fields: [originalOrderId], references: [id], onDelete: Restrict)
  replacementOrder   Order            @relation("ReplacementSaleExchange", fields: [replacementOrderId], references: [id], onDelete: Restrict)
  returns            CustomerReturn[]
  payments           Payment[]

  @@unique([shopId, idempotencyKey])
  @@index([shopId, createdAt])
  @@index([originalOrderId])
}

model ReleaseFeature {
  key       String   @id
  enabled   Boolean  @default(false)
  public    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model UnitOfMeasure {
  id        String              @id @default(cuid())
  shopId    String
  name      String
  symbol    String
  precision Int                 @default(0)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  shop      Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products  ProductUnit[]
  movements InventoryMovement[]

  @@unique([shopId, name])
  @@index([shopId])
}

model ProductUnit {
  id               String           @id @default(cuid())
  productId        String
  unitId           String
  conversionFactor Decimal          @db.Decimal(18, 6)
  isBase           Boolean          @default(false)
  canSell          Boolean          @default(true)
  canPurchase      Boolean          @default(true)
  minimumOrderQty  Decimal?         @db.Decimal(18, 3)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit             UnitOfMeasure    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  priceTiers       PriceTier[]
  barcodes         ProductBarcode[]
  priceEntries     PriceEntry[]
  promotions       Promotion[]

  @@unique([productId, unitId])
  @@index([unitId])
}

model InventoryLocation {
  id           String                 @id @default(cuid())
  shopId       String
  name         String
  type         String                 @default("SELLABLE")
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  shop         Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  balances     InventoryBalance[]
  movements    InventoryMovement[]
  reservations InventoryReservation[]
  lots         InventoryLot[]
  serials      InventorySerial[]

  @@unique([shopId, name])
  @@index([shopId])
}

model InventoryBalance {
  id         String            @id @default(cuid())
  shopId     String
  productId  String
  variantId  String?
  locationId String
  onHand     Decimal           @default(0) @db.Decimal(18, 3)
  reserved   Decimal           @default(0) @db.Decimal(18, 3)
  version    Int               @default(1)
  updatedAt  DateTime          @updatedAt
  shop       Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([shopId, productId, variantId, locationId])
  @@index([shopId, locationId])
}

model InventoryMovement {
  id               String            @id @default(cuid())
  shopId           String
  productId        String
  variantId        String?
  locationId       String
  unitId           String?
  inventoryBatchId String?
  lotId            String?
  serialId         String?
  type             String
  direction        String
  baseQuantity     Decimal           @db.Decimal(18, 3)
  enteredQuantity  Decimal           @db.Decimal(18, 3)
  conversionFactor Decimal           @default(1) @db.Decimal(18, 6)
  unitCost         Int?
  averageCostAfter Int?
  sourceType       String
  sourceId         String
  idempotencyKey   String?
  reason           String?
  staffName        String?
  occurredAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())
  shop             Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant          ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  location         InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  unit             UnitOfMeasure?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  inventoryBatch   InventoryBatch?   @relation(fields: [inventoryBatchId], references: [id], onDelete: SetNull)
  lot              InventoryLot?     @relation(fields: [lotId], references: [id], onDelete: SetNull)
  serial           InventorySerial?  @relation(fields: [serialId], references: [id], onDelete: SetNull)

  @@unique([shopId, idempotencyKey])
  @@index([shopId, occurredAt])
  @@index([productId, variantId, locationId])
  @@index([sourceType, sourceId])
}

model InventoryReservation {
  id         String            @id @default(cuid())
  shopId     String
  productId  String
  variantId  String?
  locationId String
  sourceType String
  sourceId   String
  quantity   Decimal           @db.Decimal(18, 3)
  status     String            @default("ACTIVE")
  createdAt  DateTime          @default(now())
  releasedAt DateTime?
  shop       Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([shopId, sourceType, sourceId, productId, variantId, locationId])
  @@index([shopId, status])
}

model InventoryLot {
  id               String              @id @default(cuid())
  shopId           String
  productId        String
  variantId        String?
  locationId       String
  inventoryBatchId String?
  lotNumber        String
  manufacturedAt   DateTime?
  expiresAt        DateTime?
  receivedAt       DateTime            @default(now())
  quantity         Decimal             @db.Decimal(18, 3)
  unitCost         Int
  status           String              @default("ACTIVE")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  shop             Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant          ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  location         InventoryLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  inventoryBatch   InventoryBatch?     @relation(fields: [inventoryBatchId], references: [id], onDelete: SetNull)
  movements        InventoryMovement[]

  @@unique([shopId, lotNumber])
  @@index([shopId, expiresAt])
  @@index([productId, variantId, locationId])
  @@index([shopId, status, expiresAt])
}

model InventorySerial {
  id               String                      @id @default(cuid())
  shopId           String
  productId        String
  variantId        String?
  locationId       String
  serial           String
  imei             String?
  status           String                      @default("IN_STOCK")
  soldAt           DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  shop             Shop                        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product          Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant          ProductVariant?             @relation(fields: [variantId], references: [id], onDelete: SetNull)
  location         InventoryLocation           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  movements        InventoryMovement[]
  warranties       WarrantyRecord[]
  orderAllocations OrderItemSerialAllocation[]

  @@unique([shopId, serial])
  @@unique([shopId, imei])
  @@index([productId, status])
  @@index([shopId, status])
}

model WarrantyRecord {
  id        String          @id @default(cuid())
  shopId    String
  serialId  String
  orderId   String?
  startsAt  DateTime
  endsAt    DateTime
  status    String          @default("ACTIVE")
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  shop      Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  serial    InventorySerial @relation(fields: [serialId], references: [id], onDelete: Restrict)

  @@index([shopId, status])
  @@index([serialId])
}

model Recipe {
  id             String            @id @default(cuid())
  productId      String            @unique
  yieldQuantity  Decimal           @default(1) @db.Decimal(18, 3)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  components     RecipeComponent[]
  modifierGroups ModifierGroup[]
}

model RecipeComponent {
  id                  String  @id @default(cuid())
  recipeId            String
  ingredientProductId String
  quantity            Decimal @db.Decimal(18, 3)
  recipe              Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient          Product @relation("RecipeIngredient", fields: [ingredientProductId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientProductId])
}

model ModifierGroup {
  id        String           @id @default(cuid())
  recipeId  String
  name      String
  required  Boolean          @default(false)
  minSelect Int              @default(0)
  maxSelect Int              @default(1)
  recipe    Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  options   ModifierOption[]

  @@index([recipeId])
}

model ModifierOption {
  id              String                       @id @default(cuid())
  modifierGroupId String
  name            String
  priceDelta      Int                          @default(0)
  ingredientDelta Json                         @default("[]")
  isActive        Boolean                      @default(true)
  group           ModifierGroup                @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderSelections OrderItemModifierSelection[]

  @@index([modifierGroupId])
}

model OrderItemModifierSelection {
  id               String          @id @default(cuid())
  orderItemId      String
  modifierOptionId String?
  groupName        String
  optionName       String
  priceDelta       Int             @default(0)
  ingredientDelta  Json            @default("[]")
  createdAt        DateTime        @default(now())
  orderItem        OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOption   ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: SetNull)

  @@unique([orderItemId, modifierOptionId])
  @@index([orderItemId])
}

model CustomerPriceGroup {
  id         String      @id @default(cuid())
  shopId     String
  name       String
  isActive   Boolean     @default(true)
  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customers  Customer[]
  tiers      PriceTier[]
  promotions Promotion[]

  @@unique([shopId, name])
}

model PriceTier {
  id              String              @id @default(cuid())
  productId       String
  variantId       String?
  productUnitId   String?
  priceGroupId    String?
  minimumQuantity Decimal             @db.Decimal(18, 3)
  unitPrice       Int
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productUnit     ProductUnit?        @relation(fields: [productUnitId], references: [id], onDelete: Cascade)
  priceGroup      CustomerPriceGroup? @relation(fields: [priceGroupId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]

  @@index([productId, variantId])
  @@index([priceGroupId])
}

model ProductBarcode {
  id              String          @id @default(cuid())
  shopId          String
  productId       String
  variantId       String?
  productUnitId   String?
  value           String
  normalizedValue String
  symbology       String          @default("CODE128")
  kind            String          @default("INTERNAL")
  packageQuantity Decimal?        @db.Decimal(18, 3)
  isInternal      Boolean         @default(false)
  isPrimary       Boolean         @default(false)
  status          String          @default("ACTIVE")
  version         Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  retiredAt       DateTime?
  shop            Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productUnit     ProductUnit?    @relation(fields: [productUnitId], references: [id], onDelete: SetNull)

  @@unique([shopId, normalizedValue])
  @@index([shopId, status, normalizedValue])
  @@index([productId, variantId, productUnitId])
}

model Notification {
  id        String   @id @default(cuid())
  shopId    String
  type      String
  entityId  String
  dateKey   String
  title     String
  message   String
  readAt    DateTime?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, type, entityId, dateKey])
  @@index([shopId, readAt, createdAt])
}

model SupplierDeliveryRecord {
  id            String   @id @default(cuid())
  shopId        String
  supplierId    String?
  supplierName  String
  supplierPhone String
  invoiceNumber String
  deliveryName  String
  deliveryPhone String
  receiverName  String
  receivedAt    DateTime
  dueAt         DateTime
  amount        Int
  status        String   @default("active")
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  payments      SupplierDeliveryPayment[]

  @@unique([shopId, invoiceNumber])
  @@index([shopId, supplierId, receivedAt])
}

model SupplierDeliveryPayment {
  id                String   @id @default(cuid())
  shopId            String
  deliveryRecordId  String
  amount            Int
  method            String
  reference         String?
  notes             String?
  payerName         String?
  payerPhone        String?
  signatureDataUrl  String?
  mobileAccountName String?
  paidAt            DateTime @default(now())
  reversedAt        DateTime?
  reversalReason    String?
  createdAt         DateTime @default(now())
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  deliveryRecord    SupplierDeliveryRecord @relation(fields: [deliveryRecordId], references: [id], onDelete: Cascade)
  reversal          SupplierDeliveryPaymentReversal?

  @@index([shopId, paidAt])
  @@index([deliveryRecordId])
}

/// Immutable cancellation event for a supplier payment.  The payment itself
/// remains the original financial record; this row records its reversal.
model SupplierDeliveryPaymentReversal {
  id                String   @id @default(cuid())
  shopId            String
  originalPaymentId String   @unique
  reason            String
  reversedAt        DateTime @default(now())
  actorId           String?
  createdAt         DateTime @default(now())
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  originalPayment   SupplierDeliveryPayment @relation(fields: [originalPaymentId], references: [id], onDelete: Cascade)

  @@index([shopId, reversedAt])
}

model GeneratedBarcode {
  id                String   @id @default(cuid())
  shopId            String
  value             String
  normalizedValue   String
  status            String   @default("UNASSIGNED")
  assignedProductId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  retiredAt         DateTime?
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  assignedProduct   Product? @relation(fields: [assignedProductId], references: [id], onDelete: SetNull)

  @@unique([shopId, normalizedValue])
  @@index([shopId, status])
  @@index([assignedProductId])
}

model PriceBook {
  id           String       @id @default(cuid())
  shopId       String
  name         String
  currencyCode String       @default("MMK")
  isDefault    Boolean      @default(false)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  entries      PriceEntry[]

  @@unique([shopId, name])
  @@index([shopId, isDefault, isActive])
}

model PriceEntry {
  id            String          @id @default(cuid())
  shopId        String
  priceBookId   String
  productId     String
  variantId     String?
  productUnitId String?
  targetKey     String
  unitPrice     Int
  previousUnitPrice Int?
  currencyCode  String          @default("MMK")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        String          @default("SCHEDULED")
  reason        String
  actorId       String?
  version       Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  shop          Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  priceBook     PriceBook       @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productUnit   ProductUnit?    @relation(fields: [productUnitId], references: [id], onDelete: SetNull)

  @@index([shopId, targetKey, effectiveFrom, effectiveTo])
  @@index([shopId, status, effectiveFrom])
}

model Promotion {
  id              String              @id @default(cuid())
  shopId          String
  name            String
  campaignId      String?
  productId       String
  variantId       String?
  productUnitId   String?
  priceGroupId    String?
  targetKey       String
  channel         String              @default("ALL")
  type            String
  value           Decimal             @db.Decimal(18, 4)
  minimumQuantity Decimal             @default(1) @db.Decimal(18, 3)
  discountBase    String              @default("REGULAR_PRICE")
  startsAt        DateTime
  endsAt          DateTime
  timeZone        String              @default("Asia/Yangon")
  state           String              @default("DRAFT")
  priority        Int                 @default(0)
  note            String?
  reason          String?
  actorId         String?
  version         Int                 @default(1)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  shop            Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productUnit     ProductUnit?        @relation(fields: [productUnitId], references: [id], onDelete: SetNull)
  priceGroup      CustomerPriceGroup? @relation(fields: [priceGroupId], references: [id], onDelete: SetNull)
  campaign        PromotionCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([shopId, targetKey, startsAt, endsAt])
  @@index([shopId, state, startsAt, endsAt])
  @@index([shopId, campaignId])
}

model PromotionCampaign {
  id        String      @id @default(cuid())
  shopId    String
  categoryId String?
  name      String
  scope     String
  state     String      @default("DRAFT")
  endedAt   DateTime?
  version   Int         @default(1)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  shop      Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category  Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  promotions Promotion[]

  @@index([shopId, state])
  @@index([shopId, categoryId])
}

model CustomerReturn {
  id             String    @id @default(cuid())
  shopId         String
  orderId        String
  orderItemId    String
  exchangeId     String?
  productId      String
  variantId      String?
  quantity       Decimal   @db.Decimal(18, 3)
  condition      String
  reason         String
  idempotencyKey String?
  createdAt      DateTime  @default(now())
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product        Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  exchange       SaleExchange? @relation(fields: [exchangeId], references: [id], onDelete: SetNull)

  @@unique([shopId, idempotencyKey])
  @@index([shopId, createdAt])
  @@index([orderId])
  @@index([orderItemId])
  @@index([exchangeId])
}
